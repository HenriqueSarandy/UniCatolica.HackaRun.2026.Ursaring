    { "pergunta": "Tem acessibilidade para cadeirantes?", "resposta": "Sim. O shopping tem rampas e elevadores nos dois pisos, e os banheiros são acessíveis." },
    { "pergunta": "Onde fica o SAC?", "resposta": "No piso 1, lado sul do corredor, perto da Praça Central." },
    { "pergunta": "Como encontro o cinema?", "resposta": "O Cinema Capim fica no piso 2, na ponta Oeste do corredor. Suba a escada rolante." },
    { "pergunta": "Perdi um objeto, o que faço?", "resposta": "Fale com o SAC ou peça ajuda à equipe de segurança. Eles guardam os achados e perdidos." },
    { "pergunta": "Tem carregador de celular disponível?", "resposta": "Sim, há pontos de recarga na Praça de Alimentação." },
    { "pergunta": "Posso usar cadeira de rodas emprestada?", "resposta": "Sim, peça no SAC com um documento. É gratuito." },
    { "pergunta": "Aceita vale-alimentação na praça?", "resposta": "A maioria das lojas da praça aceita. Confirme direto no balcão." }
